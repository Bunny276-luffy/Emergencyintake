{
  "name": "emergency-ai-backend",
  "version": "1.0.0",
  "description": "Emergency AI Platform Core Backend Foundation with PostgreSQL + PostGIS + WebSockets",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server/index.js",
    "dev": "prisma generate && tsx watch src/server/index.ts",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "jest --config jest.config.js --runInBand --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed:demo": "tsx src/reset_demo_state.ts"
  },
  "keywords": [
    "emergency",
    "ai",
    "backend",
    "express",
    "typescript",
    "postgresql",
    "postgis",
    "prisma",
    "websocket",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
