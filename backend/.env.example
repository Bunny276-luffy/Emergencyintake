# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Security & CORS
CORS_ORIGIN=*
JWT_SECRET=your-safe-development-secret-here

# Logging
LOG_LEVEL=info

# PostgreSQL + PostGIS Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_ai?schema=public

# Machine Learning Subsystem
ML_SERVICE_URL=http://127.0.0.1:8000

# AI & Clinical Intelligence
# GEMINI_API_KEY= (Optional: Gemini API key for paramedic voice transcription & clinical structuring. If missing, fallback response indicates service unconfigured)
